#!/bin/sh
### BEGIN INIT INFO
# Provides: vcpd
# Required-Start: $network
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: ULAMA video capture daemon
### END INIT INFO

set -u

BIN="/oem/usr/bin/vcpd"
CONF="/oem/etc/vcpd.conf"
PIDFILE="/var/run/vcpd.pid"
LOG_DIR="/var/log/vcpd"
STDOUT_LOG="$LOG_DIR/vcpd.stdout"
STDERR_LOG="$LOG_DIR/vcpd.stderr"

# Parse key=value config into CLI flags
build_args() {
    ARGS=""
    [ ! -f "$CONF" ] && return
    while IFS='=' read -r key value; do
        case "$key" in
            \#*|"") continue ;;
        esac
        value=$(echo "$value" | sed 's/#.*//' | xargs)
        [ -z "$value" ] && continue
        case "$key" in
            autostart) [ "$value" = "true" ] && ARGS="$ARGS --autostart" ;;
            verbose)   [ "$value" = "true" ] && ARGS="$ARGS --verbose" ;;
            source)    ARGS="$ARGS --source $value" ;;
            bitrate)   ARGS="$ARGS --bitrate $value" ;;
            width)     ARGS="$ARGS --width $value" ;;
            height)    ARGS="$ARGS --height $value" ;;
            fps)       ARGS="$ARGS --fps $value" ;;
            transport) ARGS="$ARGS --transport $value" ;;
            iface)     ARGS="$ARGS --iface $value" ;;
            node)      ARGS="$ARGS --node $value" ;;
            dst_node)  ARGS="$ARGS --dst-node $value" ;;
            stream_id) ARGS="$ARGS --stream-id $value" ;;
            peer)      ARGS="$ARGS --peer $value" ;;
            listen)    ARGS="$ARGS --listen $value" ;;
        esac
    done < "$CONF"
}

log() {
    echo "[S97vcpd] $*"
}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

start() {
    if [ ! -x "$BIN" ]; then
        log "ERROR: binary not found: $BIN"
        return 1
    fi

    mkdir -p "$LOG_DIR"

    if is_running; then
        log "already running (pid $(cat "$PIDFILE" 2>/dev/null))"
        return 0
    fi

    build_args
    log "starting bin=$BIN args=$ARGS"

    export LD_LIBRARY_PATH=/oem/usr/lib
    "$BIN" $ARGS >"$STDOUT_LOG" 2>"$STDERR_LOG" &
    echo $! > "$PIDFILE"
}

stop() {
    if is_running; then
        pid="$(cat "$PIDFILE" 2>/dev/null || true)"
        log "stopping pid=$pid"
        kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        return 0
    fi
    log "not running"
    rm -f "$PIDFILE"
    return 0
}

status() {
    if is_running; then
        log "running (pid $(cat "$PIDFILE" 2>/dev/null))"
        return 0
    fi
    log "stopped"
    return 3
}

case "${1:-start}" in
    start)  start ;;
    stop)   stop ;;
    restart) stop || true; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
