#!/bin/sh
### BEGIN INIT INFO
# Provides: ulama-gw
# Required-Start: $network
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: ULAMA cascade gateway daemon
### END INIT INFO

set -eu

BIN="${ULAMA_GW_BIN:-/usr/bin/ulama-gw}"
CONFIG="${ULAMA_GW_CONFIG:-/etc/ulama-gw.conf}"
PIDFILE="${ULAMA_GW_PIDFILE:-/var/run/ulama-gw.pid}"
LOG_DIR="${ULAMA_GW_LOG_DIR:-/var/log/ulama-gw}"
STDOUT_LOG="$LOG_DIR/ulama-gw.stdout"
STDERR_LOG="$LOG_DIR/ulama-gw.stderr"

log() {
    echo "[S98ulama-gw] $*"
}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

parse_args() {
    ULAMA_GW_ARGS=""
    [ -f "$CONFIG" ] || return 0

    while IFS='=' read -r key value; do
        case "$key" in \#*|"") continue ;; esac
        value=$(echo "$value" | sed 's/#.*//' | xargs)
        [ -z "$value" ] && continue

        case "$key" in
            cascade_in)    ULAMA_GW_ARGS="$ULAMA_GW_ARGS --cascade-in $value" ;;
            cascade_out)   ULAMA_GW_ARGS="$ULAMA_GW_ARGS --cascade-out $value" ;;
            transport)     ULAMA_GW_ARGS="$ULAMA_GW_ARGS --transport $value" ;;
            listen)        ULAMA_GW_ARGS="$ULAMA_GW_ARGS --listen $value" ;;
            peer)          ULAMA_GW_ARGS="$ULAMA_GW_ARGS --peer $value" ;;
            iface)         ULAMA_GW_ARGS="$ULAMA_GW_ARGS --iface $value" ;;
            channel)       ULAMA_GW_ARGS="$ULAMA_GW_ARGS --channel $value" ;;
            tx_rate_mbps)  ULAMA_GW_ARGS="$ULAMA_GW_ARGS --tx-rate-mbps $value" ;;
            node)          ULAMA_GW_ARGS="$ULAMA_GW_ARGS --node $value" ;;
            dst_mac)       ULAMA_GW_ARGS="$ULAMA_GW_ARGS --dst-mac $value" ;;
            verbose)       [ "$value" = "true" ] && ULAMA_GW_ARGS="$ULAMA_GW_ARGS --verbose" ;;
        esac
    done < "$CONFIG"
}

start() {
    if [ ! -x "$BIN" ]; then
        log "ERROR: binary not found or not executable: $BIN"
        return 1
    fi

    mkdir -p "$LOG_DIR"

    if is_running; then
        log "already running (pid $(cat "$PIDFILE" 2>/dev/null))"
        return 0
    fi

    log "starting daemon bin=$BIN"
    parse_args

    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$BIN" -- $ULAMA_GW_ARGS
    else
        "$BIN" $ULAMA_GW_ARGS >"$STDOUT_LOG" 2>"$STDERR_LOG" &
        echo $! > "$PIDFILE"
    fi
}

stop() {
    if is_running; then
        pid="$(cat "$PIDFILE" 2>/dev/null || true)"
        log "stopping pid=$pid"
        kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        return 0
    fi

    log "not running"
    rm -f "$PIDFILE"
    return 0
}

status() {
    if is_running; then
        log "running (pid $(cat "$PIDFILE" 2>/dev/null))"
        return 0
    fi

    log "stopped"
    return 3
}

case "${1:-start}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop || true
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
